{
  "manifest_version": 3,
  "name": "CORE Arona Desktop Reader",
  "version": "0.7.1",
  "description": "CORE VoiSona Reader v0.7 incremental answer reader using CORE-Arona-Desktop's local voice queue.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:32779/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CORE Arona Desktop Reader"
  }
}
