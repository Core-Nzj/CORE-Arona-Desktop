{
  "manifest_version": 3,
  "name": "FRAME Vision Receiver (Research)",
  "version": "0.2.0",
  "description": "FRAMEの画像を一時受信し、明示操作でChatGPT入力へ添付する研究用拡張。自動送信なし。",
  "action": {
    "default_title": "FRAME画像を受信",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "permissions": [
    "activeTab",
    "scripting"
  ]
}
