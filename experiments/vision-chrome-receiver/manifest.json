{
  "manifest_version": 3,
  "name": "FRAME Vision Receiver (Research)",
  "version": "0.3.1",
  "description": "研究用FRAME画像受信・ChatGPT添付・明示許可による一回限りの送信。保存なし。",
  "action": {
    "default_title": "FRAME画像を受信",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "permissions": [
    "activeTab",
    "scripting"
  ]
}
